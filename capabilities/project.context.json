{
  "id": "project.context",
  "schemaVersion": "2.0.0",
  "kind": "infra",
  "description": "Product specs and project context scaffold",
  "description_nl": "Create product specs area for non-governance project content.",
  "default": true,
  "deployment_deps": [
    "core"
  ],
  "conceptual_deps": [],
  "dependencies": [
    "core"
  ],
  "i18n": {
    "title_key": "capability.project.context.title",
    "description_key": "capability.project.context.description",
    "acceptance_keys": [
      "capability.project.context.acceptance.1",
      "capability.project.context.acceptance.2"
    ]
  },
  "rse": {
    "rule": {
      "type": "infrastructure",
      "summary_key": "capability.project.context.rule",
