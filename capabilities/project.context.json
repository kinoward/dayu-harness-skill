    }
  ],
  "asset_files": [],
  "template_files_i18n": {
    "en": [
      {
        "src": "templates.en/docs/product-specs/AGENTS.md",
        "dst": "docs/product-specs/AGENTS.md"
      },
      {
        "src": "templates.en/docs/product-specs/project-status.md",
        "dst": "docs/product-specs/project-status.md"
      }
    ]
  },
  "installer": null,
  "acceptance": [
    "Product specs AGENTS exists",
    "Project status snapshot exists"
  ],
  "suggested_when": "Enable for repositories with durable product specs or project-specific documentation."
