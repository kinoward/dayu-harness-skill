{
  "id": "release.versioning",
  "description": "Release versioning and tag protection",
  "description_nl": "Deploy SemVer and release tag guidance, tag ruleset, and local pre-push release tag guard.",
  "default": false,
  "dependencies": [
    "core",
    "git.hooks"
  ],
  "template_files": [
    {
      "src": "templates/docs/harness/guides/release-versioning.md",
      "dst": "docs/harness/guides/release-versioning.md"
    }
  ],
  "asset_files": [
    {
      "src": "assets/github/rulesets/protect-tags.json",
      "dst": ".github/rulesets/protect-tags.json"
    }
  ],
  "remote_actions": [
    {
      "kind": "ruleset",
      "name": "protect-tags",
      "api": "POST|PUT /repos/{owner}/{repo}/rulesets",
      "target_path": ".github/rulesets/protect-tags.json",
      "target": "tag",
      "requires": [
        "gh_auth",
        "admin"
      ]
    }
  ],
  "installer": {
    "script": "install-husky.sh",
    "safe_strategies": [
      "merge",
      "skip"
    ],
    "notes": "Installs only the pre-push release tag protection snippet."
  },
  "acceptance": [
    "Release versioning guide exists",
    "Tag ruleset exists",
    "Pre-push hook protects v* release tags"
  ],
  "suggested_when": "Enable when release versioning and tag protection are required.",
  "template_files_i18n": {
    "en": [
      {
        "src": "templates.en/docs/harness/guides/release-versioning.md",
        "dst": "docs/harness/guides/release-versioning.md"
      }
    ]
  }
}
