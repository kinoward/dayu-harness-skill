{
  "id": "github.issue",
  "description": "GitHub issue body dependency lint",
  "description_nl": "Deploy issue lint workflow and depends-on body validator.",
  "default": false,
  "dependencies": [
    "core"
  ],
  "template_files": [
    {
      "src": "templates/docs/harness/guides/issue-guidelines.md",
      "dst": "docs/harness/guides/issue-guidelines.md"
    }
  ],
  "asset_files": [
    {
      "src": "assets/github/workflows/issue-lint.yml",
      "dst": ".github/workflows/issue-lint.yml"
    },
    {
      "src": "assets/github/ISSUE_TEMPLATE/dayu-harness-issue.md",
      "dst": ".github/ISSUE_TEMPLATE/dayu-harness-issue.md"
    },
    {
      "src": "assets/github/scripts/issue_depends_on.py",
      "dst": ".github/scripts/issue_depends_on.py"
    }
  ],
  "installer": null,
  "acceptance": [
    "Issue lint workflow exists",
    "Issue depends-on validator exists",
    "Issue linting guide exists"
  ],
  "suggested_when": "Enable when project uses GitHub issues.",
  "template_files_i18n": {
    "en": [
      {
        "src": "templates.en/docs/harness/guides/issue-guidelines.md",
        "dst": "docs/harness/guides/issue-guidelines.md"
      }
    ]
  }
}
