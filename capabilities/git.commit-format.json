{
  "id": "git.commit-format",
  "schemaVersion": "2.0.0",
  "kind": "hard",
  "description": "Conventional Commits validation and commit format guidance",
  "description_nl": "Enable Conventional Commits guidance, commitlint config, and commit-msg format validation.",
  "default": true,
  "deployment_deps": [
    "core",
    "git.hooks"
  ],
  "conceptual_deps": [],
  "dependencies": [
    "core",
    "git.hooks"
  ],
  "i18n": {
    "title_key": "capability.git.commit-format.title",
    "description_key": "capability.git.commit-format.description",
    "acceptance_keys": [
      "capability.git.commit-format.acceptance.1",
      "capability.git.commit-format.acceptance.2",
      "capability.git.commit-format.acceptance.3"
    ]
  },
  "rse": {
    "rule": {
      "type": "documentation",
      "summary_key": "capability.git.commit-format.rule",
      "artifacts": [
        "docs/harness/guides/commit-guidelines.md",
        "commitlint.config.cjs",
        ".husky/"
      ]
    },
    "sensor": {
      "type": "config",
      "checks": [
        "commitlint.config.cjs",
        ".husky/commit-msg"
      ],
      "summary_key": "capability.git.commit-format.sensor"
    },
    "enforcer": {
      "type": "hook",
      "mechanisms": [
        "commit-msg"
      ],
      "summary_key": "capability.git.commit-format.enforcer"
    }
  },
  "template_files": [
    {
      "src": "templates/docs/harness/guides/commit-guidelines.md",
      "dst": "docs/harness/guides/commit-guidelines.md"
    }
  ],
  "asset_files": [
    {
      "src": "assets/commitlint/commitlint.config.cjs",
      "dst": "commitlint.config.cjs"
    }
  ],
  "template_files_i18n": {
    "en": [
      {
        "src": "templates.en/docs/harness/guides/commit-guidelines.md",
        "dst": "docs/harness/guides/commit-guidelines.md"
      }
    ]
  },
  "installer": {
    "script": "install-husky.sh",
    "safe_strategies": [
      "merge",
      "skip"
    ],
    "notes": "Installs only the commit-msg Conventional Commits snippet."
  },
  "acceptance": [
    "commit-msg hook includes Conventional Commits validation",
    "commitlint.config.cjs exists",
    "No existing hooks replaced by default"
  ],
  "requires": [
    "Git repository context"
  ],
  "suggested_when": "Enable when project enforces git commit conventions."
}
