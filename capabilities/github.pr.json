{
  "id": "github.pr",
  "description": "GitHub pull request hygiene workflows",
  "description_nl": "Deploy PR lint workflows and helper script for CI-side checks.",
  "default": false,
  "dependencies": ["core"],
  "template_files": [
    {"src":"templates/docs/practices/pr-guidelines.md","dst":"docs/practices/pr-guidelines.md"},
    {"src":"templates/docs/practices/code-review-checklist.md","dst":"docs/practices/code-review-checklist.md"}
  ],
  "asset_files": [
    {"src":"assets/github/workflows/pr-lint.yml","dst":".github/workflows/pr-lint.yml"},
    {"src":"assets/github/workflows/issue-lint.yml","dst":".github/workflows/issue-lint.yml"},
    {"src":"assets/github/scripts/pr_body_structure.py","dst":".github/scripts/pr_body_structure.py"}
  ],
  "installer": null,
  "acceptance": [
    "PR lint workflow exists",
    "Issue lint workflow exists",
    "PR body validator script exists"
  ],
  "suggested_when": "Enable when project uses GitHub pull requests."
}
