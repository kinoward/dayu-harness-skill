{
  "id": "quality.node-tooling",
  "schemaVersion": "2.0.0",
  "kind": "hard",
  "description": "Node.js linting and formatting tooling",
  "description_nl": "Enable ESLint, Prettier, lint-staged, and the pre-commit lint-staged hook.",
  "default": false,
  "deployment_deps": [
    "core",
    "git.hooks"
  ],
  "conceptual_deps": [
    "quality.practices"
  ],
  "dependencies": [
    "core",
    "git.hooks"
  ],
  "i18n": {
    "title_key": "capability.quality.node-tooling.title",
    "description_key": "capability.quality.node-tooling.description",
    "acceptance_keys": [
      "capability.quality.node-tooling.acceptance.1",
      "capability.quality.node-tooling.acceptance.2",
      "capability.quality.node-tooling.acceptance.3",
      "capability.quality.node-tooling.acceptance.4"
    ]
  },
  "rse": {
    "rule": {
      "type": "configuration",
      "summary_key": "capability.quality.node-tooling.rule",
      "artifacts": [
        "eslint.config.cjs",
        ".prettierrc",
        ".lintstagedrc.json",
        ".husky/"
      ]
    },
    "sensor": {
      "type": "config",
      "checks": [
        "eslint.config.cjs",
        ".prettierrc",
        ".lintstagedrc.json",
        ".husky/pre-commit"
      ],
      "summary_key": "capability.quality.node-tooling.sensor"
    },
    "enforcer": {
      "type": "hook",
      "mechanisms": [
        "pre-commit lint-staged"
      ],
      "summary_key": "capability.quality.node-tooling.enforcer"
    }
  },
  "template_files": [],
  "asset_files": [
    {
      "src": "assets/eslint/eslint.config.cjs",
      "dst": "eslint.config.cjs"
    },
    {
      "src": "assets/prettier/.prettierrc",
      "dst": ".prettierrc"
    },
    {
      "src": "assets/lint-staged/.lintstagedrc.json",
      "dst": ".lintstagedrc.json"
    }
  ],
  "installer": {
    "script": "install-husky.sh",
    "safe_strategies": [
      "merge",
      "skip"
    ],
    "notes": "Installs only the pre-commit lint-staged snippet."
  },
  "acceptance": [
    "ESLint config exists",
    "Prettier config exists",
    "lint-staged config exists",
    "pre-commit hook runs lint-staged"
  ],
  "suggested_when": "Enable when project uses Node.js linting or formatting."
}
