{
  "id": "github.repository-settings",
  "description": "Repository pull request automation settings",
  "description_nl": "部署 GitHub 仓库 PR 自动合并策略配置，并在 apply 阶段同步远端设置。",
  "default": false,
  "dependencies": [
    "core"
  ],
  "template_files": [
    {
      "src": "templates/docs/harness/guides/github-repository-settings.md",
      "dst": "docs/harness/guides/github-repository-settings.md"
    }
  ],
  "asset_files": [
    {
      "src": "assets/github/repository/pull-request-settings.json",
      "dst": ".github/repository/pull-request-settings.json"
    }
  ],
  "remote_actions": [
    {
      "kind": "repository_settings",
      "api": "PATCH /repos/{owner}/{repo}",
      "requires": [
        "gh_auth",
        "admin"
      ],
      "settings": {
        "allow_merge_commit": true,
        "allow_squash_merge": false,
        "allow_rebase_merge": false,
        "allow_auto_merge": true,
        "delete_branch_on_merge": true
      }
    }
  ],
  "installer": null,
  "acceptance": [
    "Repository pull request settings file exists",
    "Repository settings guide exists",
    "Repository merge commit is enabled, squash/rebase merge are disabled, and auto-merge/delete-branch-on-merge are synchronized through GitHub API during apply"
  ],
  "suggested_when": "Enable when release automation requires deterministic PR merge behavior.",
  "template_files_i18n": {
    "en": [
      {
        "src": "templates.en/docs/harness/guides/github-repository-settings.md",
        "dst": "docs/harness/guides/github-repository-settings.md"
      }
    ]
  }
}
