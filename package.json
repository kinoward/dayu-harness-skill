{
  "name": "dayu-harness",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "bin": {
    "dayu-harness": "dist/cli/main.js"
  },
  "files": [
    "dist/",
    "assets/",
    "capabilities/",
    "locales/",
    "templates/",
    "templates.en/",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "dayu": "TMPDIR=.tmp tsx src/cli/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "npm run typecheck",
    "i18n:check": "TMPDIR=.tmp tsx src/cli/main.ts i18n-drift --json",
    "update-readme-contributors": "TMPDIR=.tmp tsx src/maintenance/update-readme-contributors.ts"
  },
  "dependencies": {
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "yaml": "^2.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
