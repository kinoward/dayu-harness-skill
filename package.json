{
  "name": "dayu-harness-skill",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "dayu-harness": "./src/cli/main.ts"
  },
  "scripts": {
    "dayu": "TMPDIR=.tmp tsx src/cli/main.ts",
    "test": "npm run test:unit",
    "test:unit": "TMPDIR=.tmp node --import tsx --test tests/unit/*.test.ts",
    "test:phase1b": "TMPDIR=.tmp node --import tsx --test tests/unit/phase1b-schema.test.ts",
    "test:phase1c": "TMPDIR=.tmp node --import tsx --test tests/unit/phase1c-architecture.test.ts",
    "test:phase1d": "TMPDIR=.tmp node --import tsx --test tests/unit/phase1d-cli.test.ts",
    "test:phase1e": "TMPDIR=.tmp node --import tsx --test tests/unit/phase1e-cli-scope.test.ts"
  },
  "dependencies": {
    "commander": "^14.0.3",
    "yaml": "^2.8.2",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
