#!/usr/bin/env bash
# commit-msg hook
# 安装路径: .husky/commit-msg

COMMIT_MSG_FILE="$1"

# 1. 剥离 AI Co-Authored-By 署名
# Claude Code / Cursor / Copilot 等 AI 工具自动生成的署名行不应进入永久 git 历史
if grep -qiE '(^Co-Authored-By:|^Co-authored-by:)' "$COMMIT_MSG_FILE"; then
    sed -i.bak '/^Co-Authored-By:/Id; /^Co-authored-by:/Id' "$COMMIT_MSG_FILE"
    rm -f "${COMMIT_MSG_FILE}.bak"
fi

# 2. CJK 字符检测
if grep -q -- "<!-- skip-cjk-check -->" "$COMMIT_MSG_FILE"; then
    echo "SKIP: commit message contains <!-- skip-cjk-check --> marker."
else
    CJK_MATCHES=$(perl -Mutf8 '-Mopen=:std,:encoding(UTF-8)' -ne 'print "$.:$_" if /[\x{4E00}-\x{9FFF}\x{3040}-\x{309F}\x{30A0}-\x{30FF}\x{AC00}-\x{D7AF}\x{3000}-\x{303F}\x{FF00}-\x{FFEF}]/' "$COMMIT_MSG_FILE" 2>/dev/null || true)
    if [ -n "$CJK_MATCHES" ]; then
        echo ""
        echo "ERROR: commit message contains CJK characters."
        echo "Commit messages must be in English. See docs/harness/guides/git-language-policy.md"
        echo ""
        echo "Offending lines:"
        printf '%s\n' "$CJK_MATCHES"
        exit 1
    fi
fi

# 3. 拦截 commit 中的 issue 引用
# Closes #N / Fixes #N / Refs #N 等引用只能在 PR body 中出现，不能出现在单个 commit 中。
# 在 commit 中包含会导致 release-please changelog 重复条目和 issue 过早自动关闭。
if grep -qiE '^(Closes|Fixes|Resolves|Refs)[[:space:]]*#[0-9]+' "$COMMIT_MSG_FILE"; then
    echo ""
    echo "ERROR: Issue reference trailers (Closes #N, Fixes #N, Refs #N) are not"
    echo "allowed in individual commit messages."
    echo "Use them only in the PR body."
    echo ""
    echo "See docs/harness/guides/pr-guidelines.md"
    echo ""
    echo "Offending lines:"
    grep -inE '^(Closes|Fixes|Resolves|Refs)[[:space:]]*#[0-9]+' "$COMMIT_MSG_FILE"
    exit 1
fi

# 4. Conventional Commits 格式校验（由 commitlint 处理）
if command -v npx &> /dev/null && [ -f "commitlint.config.cjs" ]; then
    npx --no-install commitlint --edit "$COMMIT_MSG_FILE" 2>/dev/null || {
        echo ""
        echo "ERROR: commit message does not follow Conventional Commits format."
        echo "Format: type(scope): description"
        echo "Types: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
        exit 1
    }
fi
